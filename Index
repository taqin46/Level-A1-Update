<script>
const VOCAB = [
  {en:'About', id:'Tentang', def:'On the subject of', syn:'Regarding', ant:'None', synOpts:['Regarding','Above','Across'], antOpts:['None','Below','Far']},
  {en:'Above', id:'Di atas', def:'Higher than something', syn:'Over', ant:'Below', synOpts:['Over','Under','Near'], antOpts:['Below','Beside','Inside']},
  {en:'Across', id:'Melintasi', def:'From one side to the other', syn:'Over', ant:'None', synOpts:['Over','Behind','Under'], antOpts:['None','Stay','Close']},
  {en:'Activity', id:'Aktivitas', def:'Something that you do', syn:'Action', ant:'Inactivity', synOpts:['Action','Rest','Sleep'], antOpts:['Inactivity','Work','Play']},
  {en:'Afraid', id:'Takut', def:'Feeling fear', syn:'Scared', ant:'Brave', synOpts:['Scared','Happy','Angry'], antOpts:['Brave','Sad','Calm']},
  {en:'After', id:'Setelah', def:'Later than something', syn:'Later', ant:'Before', synOpts:['Later','Soon','Early'], antOpts:['Before','During','Now']},
  {en:'Always', id:'Selalu', def:'At all times', syn:'Ever', ant:'Never', synOpts:['Ever','Often','Sometimes'], antOpts:['Never','Daily','Rarely']},
  {en:'Beautiful', id:'Indah', def:'Pleasing to the eye', syn:'Pretty', ant:'Ugly', synOpts:['Pretty','Dirty','Old'], antOpts:['Ugly','New','Fast']},
  {en:'Big', id:'Besar', def:'Large in size', syn:'Large', ant:'Small', synOpts:['Large','Tall','High'], antOpts:['Small','Short','Tiny']},
  {en:'Cheap', id:'Murah', def:'Low in price', syn:'Inexpensive', ant:'Expensive', synOpts:['Inexpensive','Good','Easy'], antOpts:['Expensive','Rich','Hard']},
  {en:'Clean', id:'Bersih', def:'Not dirty', syn:'Neat', ant:'Dirty', synOpts:['Neat','Clear','Fresh'], antOpts:['Dirty','Old','Dark']},
  {en:'Cold', id:'Dingin', def:'Low temperature', syn:'Chilly', ant:'Hot', synOpts:['Chilly','Cool','Icy'], antOpts:['Hot','Warm','Dry']},
  {en:'Difficult', id:'Sulit', def:'Not easy', syn:'Hard', ant:'Easy', synOpts:['Hard','Complex','Tough'], antOpts:['Easy','Simple','Light']},
  {en:'Early', id:'Awal', def:'Before the usual time', syn:'First', ant:'Late', synOpts:['First','Quick','Soon'], antOpts:['Late','Slow','After']},
  {en:'Fast', id:'Cepat', def:'Moving at high speed', syn:'Quick', ant:'Slow', synOpts:['Quick','Rapid','Swift'], antOpts:['Slow','Heavy','Long']},
  {en:'Happy', id:'Senang', def:'Feeling joy', syn:'Joyful', ant:'Sad', synOpts:['Joyful','Cheerful','Glad'], antOpts:['Sad','Angry','Upset']},
  {en:'High', id:'Tinggi', def:'At a great distance up', syn:'Tall', ant:'Low', synOpts:['Tall','Big','Great'], antOpts:['Low','Short','Small']},
  {en:'Hot', id:'Panas', def:'High temperature', syn:'Burning', ant:'Cold', synOpts:['Burning','Warm','Sunny'], antOpts:['Cold','Cool','Breezy']},
  {en:'Kind', id:'Baik Hati', def:'Friendly and generous', syn:'Nice', ant:'Cruel', synOpts:['Nice','Gentle','Good'], antOpts:['Cruel','Mean','Bad']},
  {en:'New', id:'Baru', def:'Recently made', syn:'Fresh', ant:'Old', synOpts:['Fresh','Modern','Young'], antOpts:['Old','Ancient','Past']},
  {en:'Rich', id:'Kaya', def:'Having much money', syn:'Wealthy', ant:'Poor', synOpts:['Wealthy','Full','Great'], antOpts:['Poor','Empty','Weak']},
  {en:'Strong', id:'Kuat', def:'Having physical power', syn:'Powerful', ant:'Weak', synOpts:['Powerful','Hard','Solid'], antOpts:['Weak','Soft','Gentle']},
  {en:'Tall', id:'Tinggi', def:'Above average height', syn:'High', ant:'Short', synOpts:['High','Big','Long'], antOpts:['Short','Low','Small']},
  {en:'Young', id:'Muda', def:'Not old', syn:'Junior', ant:'Old', synOpts:['Junior','New','Small'], antOpts:['Old','Senior','Adult']}
];

let currentMode = 'home';
let currentMcqMode = 'synonym';
let matchSelected = {side: null, idx: null};
let matchLocked = [];
let matchScore = 0;
let matchData = [];
let matchType = 'engind';
let mcqIdx = 0;
let mcqScore = 0;
let mcqAnswered = false;

function shuffle(arr) { return [...arr].sort(()=>Math.random()-0.5); }

function toggleMenu() {
  const btn = document.getElementById('burgerBtn');
  const menu = document.getElementById('dropdownMenu');
  const overlay = document.getElementById('menuOverlay');
  btn.classList.toggle('open');
  menu.classList.toggle('open');
  overlay.classList.toggle('open');
}

function closeMenu() {
  document.getElementById('burgerBtn').classList.remove('open');
  document.getElementById('dropdownMenu').classList.remove('open');
  document.getElementById('menuOverlay').classList.remove('open');
}

function toggleSubmenu(id, el) {
  const sub = document.getElementById(id);
  const arrow = document.getElementById('matchArrow');
  sub.classList.toggle('open');
  arrow.classList.toggle('open');
}

function showScreen(id) {
  ['screenHome','screenFlash','screenFill','screenMatch','screenMcq'].forEach(s => {
    document.getElementById(s).classList.add('hidden');
  });
  const el = document.getElementById(id);
  el.classList.remove('hidden');
  el.classList.remove('fade-in');
  void el.offsetWidth;
  el.classList.add('fade-in');
}

function goHome() {
  closeMenu();
  showScreen('screenHome');
  document.getElementById('navLabel').textContent = 'Model';
}

function navigate(mode) {
  closeMenu();
  currentMode = mode;
  if(mode==='flash') { document.getElementById('navLabel').textContent='🃏 Flash Card'; showScreen('screenFlash'); initFlash(); }
  else if(mode==='fill') { document.getElementById('navLabel').textContent='✏️ Isikan Arti'; showScreen('screenFill'); initFill(); }
  else if(mode.startsWith('match')) {
    matchType = mode==='match-engind' ? 'engind' : 'engeng';
    document.getElementById('navLabel').textContent='🔗 Mencocokan Arti';
    document.getElementById('tabEngInd').classList.toggle('active', matchType==='engind');
    document.getElementById('tabEngEng').classList.toggle('active', matchType==='engeng');
    showScreen('screenMatch');
    initMatch();
  }
  else if(mode==='synonym') { currentMcqMode='synonym'; document.getElementById('navLabel').textContent='💬 Sinonim'; document.getElementById('mcqTitle').innerHTML='💬 Sinonim'; showScreen('screenMcq'); initMcq('synonym'); }
  else if(mode==='antonym') { currentMcqMode='antonym'; document.getElementById('navLabel').textContent='↔️ Antonim'; document.getElementById('mcqTitle').innerHTML='↔️ Antonim'; showScreen('screenMcq'); initMcq('antonym'); }
}

// FLASH CARD
function initFlash() {
  const grid = document.getElementById('flashGrid');
  const words = shuffle(VOCAB).slice(0,10);
  grid.innerHTML = '';
  words.forEach((w,i) => {
    grid.innerHTML += `
    <div class="flashcard-scene" id="fc${i}" onclick="flipCard(${i})">
      <div class="flashcard-inner">
        <div class="flashcard-face flashcard-front">
          <span class="fc-num">${i+1}</span>
          <span class="word">${w.en}</span>
          <span class="hint">Klik untuk lihat arti</span>
          <span class="fc-flip-icon">🔄</span>
        </div>
        <div class="flashcard-face flashcard-back">
          <span class="fc-num">${i+1}</span>
          <span class="meaning">${w.id}</span>
          <span class="hint">Klik untuk kembali</span>
          <span class="fc-flip-icon">🔄</span>
        </div>
      </div>
    </div>`;
  });
}
function flipCard(i) {
  document.getElementById('fc'+i).classList.toggle('flipped');
}

// FILL IN
let fillWords = [];
function initFill() {
  fillWords = shuffle(VOCAB).slice(0,10);
  const list = document.getElementById('fillList');
  list.innerHTML = '';
  document.getElementById('fillResult').classList.add('hidden');
  document.getElementById('fillSubmitBtn').classList.remove('hidden');
  fillWords.forEach((w,i) => {
    list.innerHTML += `
    <div class="fill-item" id="fillItem${i}">
      <div class="fill-num">${i+1}</div>
      <div class="fill-word">${w.en}</div>
      <input class="fill-input" id="fillInput${i}" type="text" placeholder="Ketik artinya..." autocomplete="off">
      <span class="fill-check" id="fillCheck${i}"></span>
    </div>`;
  });
}
function checkFill() {
  let correct = 0;
  fillWords.forEach((w,i) => {
    const input = document.getElementById('fillInput${i}');
    const inp = document.getElementById('fillInput'+i);
    const check = document.getElementById('fillCheck'+i);
    const item = document.getElementById('fillItem'+i);
    const val = inp.value.trim().toLowerCase();
    const ans = w.id.toLowerCase();
    if(val===ans || val===w.en.toLowerCase()) {
      item.classList.add('correct'); item.classList.remove('wrong');
      check.textContent = '✅'; inp.disabled = true; correct++;
    } else if(val==='') {
      item.classList.remove('correct','wrong'); check.textContent='';
    } else {
      item.classList.add('wrong'); item.classList.remove('correct');
      check.textContent = '❌';
      setTimeout(()=>item.classList.remove('wrong'),500);
      const hint = document.createElement('span');
      hint.className='fill-item-wrong-ans';
      hint.textContent = '→ '+w.id;
      if(!item.querySelector('.fill-item-wrong-ans')) item.appendChild(hint);
    }
  });
  const res = document.getElementById('fillResult');
  document.getElementById('fillScoreText').textContent = correct+'/10';
  res.classList.remove('hidden');
  if(correct===10) showCongrats('Sempurna! Semua benar!', correct+' dari 10 kata benar!');
  else if(correct>=7) showCongrats('Bagus Sekali!', correct+' dari 10 kata benar! Terus berlatih.');
  document.getElementById('fillSubmitBtn').classList.add('hidden');
}

// MATCH GAME
let matchLeftData = [], matchRightData = [];
let matchLeftSelected = null, matchRightSelected = null;

function initMatch() {
  matchLocked = [];
  matchScore = 0;
  matchLeftSelected = null;
  matchRightSelected = null;
  updateMatchScore();
  const words = shuffle(VOCAB).slice(0,5);
  matchData = words;
  matchLeftData = shuffle(words.map((_,i)=>i));
  matchRightData = shuffle(words.map((_,i)=>i));

  const leftCol = document.getElementById('matchLeft');
  const rightCol = document.getElementById('matchRight');
  leftCol.innerHTML = '';
  rightCol.innerHTML = '';

  if(matchType==='engind') {
    document.getElementById('matchLeftTitle').textContent='Kata Inggris';
    document.getElementById('matchRightTitle').textContent='Bahasa Indonesia';
  } else {
    document.getElementById('matchLeftTitle').textContent='Kata';
    document.getElementById('matchRightTitle').textContent='Definisi';
  }

  matchLeftData.forEach((wi,i) => {
    const w = matchData[wi];
    leftCol.innerHTML += `<div class="match-item" id="ml${i}" data-idx="${wi}" onclick="selectMatchItem('left',${i},${wi})">${w.en}</div>`;
  });
  matchRightData.forEach((wi,i) => {
    const w = matchData[wi];
    const label = matchType==='engind' ? w.id : w.def;
    rightCol.innerHTML += `<div class="match-item" id="mr${i}" data-idx="${wi}" onclick="selectMatchItem('right',${i},${wi})">${label}</div>`;
  });
}

function selectMatchItem(side, i, dataIdx) {
  const isLocked = matchLocked.includes(dataIdx);
  if(isLocked) return;

  if(side==='left') {
    // deselect previous left
    if(matchLeftSelected !== null) {
      document.getElementById('ml'+matchLeftData.indexOf(matchLeftSelected))?.classList.remove('selected');
    }
    matchLeftSelected = dataIdx;
    document.getElementById('ml'+i).classList.add('selected');
  } else {
    if(matchRightSelected !== null) {
      const prevRI = matchRightData.indexOf(matchRightSelected);
      document.getElementById('mr'+prevRI)?.classList.remove('selected');
    }
    matchRightSelected = dataIdx;
    document.getElementById('mr'+i).classList.add('selected');
  }

  // Try to match
  if(matchLeftSelected !== null && matchRightSelected !== null) {
    if(matchLeftSelected === matchRightSelected) {
      // Match!
      const li = matchLeftData.indexOf(matchLeftSelected);
      const ri = matchRightData.indexOf(matchRightSelected);
      const lEl = document.getElementById('ml'+li);
      const rEl = document.getElementById('mr'+ri);
      lEl.classList.remove('selected'); lEl.classList.add('locked');
      rEl.classList.remove('selected'); rEl.classList.add('locked');
      matchLocked.push(matchLeftSelected);
      matchScore++;
      updateMatchScore();
      matchLeftSelected = null; matchRightSelected = null;
      if(matchScore === 5) {
        setTimeout(()=>showCongrats('Amazing! 🎉', 'Semua pasangan berhasil dicocokkan!'), 500);
      }
    } else {
      // Wrong
      const li = matchLeftData.indexOf(matchLeftSelected);
      const ri = matchRightData.indexOf(matchRightSelected);
      document.getElementById('ml'+li)?.classList.add('wrong-flash');
      document.getElementById('mr'+ri)?.classList.add('wrong-flash');
      setTimeout(()=>{
        document.getElementById('ml'+li)?.classList.remove('wrong-flash','selected');
        document.getElementById('mr'+ri)?.classList.remove('wrong-flash','selected');
      }, 500);
      matchLeftSelected = null; matchRightSelected = null;
    }
  }
}

function updateMatchScore() {
  document.getElementById('matchScoreVal').textContent = matchScore+'/5';
  document.getElementById('matchScoreBar').style.width = (matchScore/5*100)+'%';
}

function resetMatch() {
  initMatch();
}

// MCQ (Synonym / Antonym)
let mcqWords = [];
function initMcq(mode) {
  currentMcqMode = mode;
  mcqWords = shuffle(VOCAB);
  mcqIdx = 0;
  mcqScore = 0;
  renderMcq();
}

function renderMcq() {
  if(mcqIdx >= mcqWords.length) {
    showCongrats(getCongratsTitle(mcqScore, mcqWords.length), 'Skor kamu: '+mcqScore+' dari '+mcqWords.length+'!');
    return;
  }
  mcqAnswered = false;
  const w = mcqWords[mcqIdx];
  document.getElementById('mcqScore').textContent = mcqScore;
  document.getElementById('mcqQNum').textContent = (mcqIdx+1)+'/'+mcqWords.length;
  document.getElementById('mcqProg').style.width = (mcqIdx/mcqWords.length*100)+'%';
  const opts = currentMcqMode==='synonym' ? w.synOpts : w.antOpts;
  const answer = currentMcqMode==='synonym' ? w.syn : w.ant;
  const question = currentMcqMode==='synonym' ? 'Sinonim dari:' : 'Antonim dari:';
  const label = currentMcqMode==='synonym' ? 'kata yang sepadan/bermakna sama' : 'kata yang berlawanan makna';
  let html = `
    <div class="mcq-question">${question}</div>
    <div class="mcq-word">${w.en}</div>
    <div class="mcq-hint">${w.id} — ${label}</div>
    <div class="mcq-options" id="mcqOptions">`;
  shuffle(opts).forEach((opt,i) => {
    html += `<div class="mcq-option" id="mcqOpt${i}" onclick="answerMcq(${i},'${opt}','${answer}')">
      <span class="mcq-option-letter">${'ABC'[i]}</span>${opt}</div>`;
  });
  html += `</div>`;
  document.getElementById('mcqCard').innerHTML = html;
}

function answerMcq(i, selected, answer) {
  if(mcqAnswered) return;
  mcqAnswered = true;
  const opts = document.querySelectorAll('.mcq-option');
  opts.forEach(opt => opt.classList.add('answered'));
  const el = document.getElementById('mcqOpt'+i);
  if(selected===answer) {
    el.classList.add('correct');
    el.querySelector('.mcq-option-letter').textContent = '✓';
    mcqScore++;
  } else {
    el.classList.add('wrong');
    el.querySelector('.mcq-option-letter').textContent = '✗';
    // Show correct answer
    opts.forEach(opt => {
      if(opt.textContent.includes(answer)) { opt.classList.add('correct'); }
    });
  }
  document.getElementById('mcqCard').innerHTML += `<button class="mcq-next-btn" onclick="mcqNext()">Lanjut ➡</button>`;
}

function mcqNext() {
  mcqIdx++;
  renderMcq();
}

// CONGRATS
const congratsTitles = ['Amazing! 🎊','Luar Biasa! 🏆','Sempurna! ⭐','Hebat! 🎯','Keren Banget! 🔥','Bravo! 👏','Fantastic! 💥','Perfect! 💯'];
const congratsEmojis = ['🏆','🥇','🎯','🌟','🎉','💎','🔥','⚡'];

function getCongratsTitle(score, total) {
  if(score===total) return 'SEMPURNA! 💯';
  if(score/total >= 0.8) return 'Luar Biasa! 🏆';
  if(score/total >= 0.6) return 'Bagus! 🎯';
  return 'Terus Berlatih! 💪';
}

function showCongrats(title, sub) {
  const r = Math.floor(Math.random()*congratsTitles.length);
  document.getElementById('modalTitle').textContent = title || congratsTitles[r];
  document.getElementById('modalSub').textContent = sub || '';
  document.getElementById('modalEmoji').textContent = congratsEmojis[r];
  document.getElementById('modalOverlay').classList.remove('hidden');
  ['star1','star2','star3'].forEach(id => {
    const s = document.getElementById(id);
    s.classList.remove('show');
    void s.offsetWidth;
  });
  setTimeout(()=>{ document.getElementById('star1').classList.add('show'); },150);
  setTimeout(()=>{ document.getElementById('star2').classList.add('show'); },350);
  setTimeout(()=>{ document.getElementById('star3').classList.add('show'); },550);
}

function closeModal() {
  document.getElementById('modalOverlay').classList.add('hidden');
}

// Init
initFlash();
</script>
